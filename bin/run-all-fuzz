#!/usr/bin/env bash
#
# Run every <distribution>/t/all-fuzz.t in this workspace against the
# App-Test-Generator working tree.
#
# Usage:
#   ./run-all-fuzz.sh
#
# Exits 0 only when every suite passes.  On failure, the failing suites'
# output is printed and the full logs are kept.

set -u

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
atg="$root/App-Test-Generator"

if [[ ! -d "$atg/lib" ]]; then
	printf 'error: App-Test-Generator not found at %s\n' "$atg" >&2
	exit 2
fi

# Use the working tree, not whatever App::Test::Generator is installed.
export EXTENDED_TESTING=1
export PERL5LIB="$atg/lib${PERL5LIB:+:$PERL5LIB}"
export PATH="$atg/bin:$PATH"

mapfile -t tests < <(
	find "$root" -mindepth 3 -maxdepth 3 -type f -path '*/t/all-fuzz.t' -print \
		| sort
)

if ((${#tests[@]} == 0)); then
	printf 'error: no */t/all-fuzz.t found under %s\n' "$root" >&2
	exit 2
fi

logs=$(mktemp -d "${TMPDIR:-/tmp}/all-fuzz.XXXXXX") || exit 2

pids=()
names=()
for test in "${tests[@]}"; do
	dir=${test%/t/all-fuzz.t}
	name=${dir##*/}
	names+=("$name")

	(
		cd "$dir" || exit 2
		prove -Ilib t/all-fuzz.t >"$logs/$name.log" 2>&1
		rc=$?
		printf '%s\n' "$rc" >"$logs/$name.status"
		exit "$rc"
	) &
	pids+=("$!")
done

for pid in "${pids[@]}"; do
	wait "$pid" || true
done

printf '\nall-fuzz results (ATG: %s)\n' "$atg"
printf '%s\n' '----------------------------------------'

failures=()
for name in "${names[@]}"; do
	rc=$(cat "$logs/$name.status" 2>/dev/null || printf '2')
	if [[ "$rc" == 0 ]]; then
		printf 'PASS  %s\n' "$name"
	else
		printf 'FAIL  %s (exit %s)\n' "$name" "$rc"
		failures+=("$name")
	fi
done

if ((${#failures[@]})); then
	for name in "${failures[@]}"; do
		printf '\n===== %s =====\n' "$name"
		tail -n 40 "$logs/$name.log"
	done
	printf '\nFull logs kept in %s\n' "$logs"
	exit 1
fi

rm -rf "$logs"
printf '\nAll all-fuzz suites passed.\n'
